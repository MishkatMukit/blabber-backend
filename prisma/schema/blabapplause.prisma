model BlabApplause {
  userId    String
  blabId    String
  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  blab Blab    @relation(fields: [blabId], references: [id], onDelete: Cascade)

  @@id([userId, blabId])
  @@map("blab_applause")
}